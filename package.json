{
  "name": "@andrioid/paseo-attention-span",
  "version": "0.0.0-development",
  "description": "For when your attention is spread thin: the GitHub issues and pull requests waiting on you, grouped by why, with one-tap Paseo sessions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrioid/paseo-attention-span.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "!**/*.test.ts",
    "assets/",
    "docs/screenshots/desktop-dark-doing-acknowledge.png",
    "docs/screenshots/desktop-dark-doing-session-menu.png",
    "docs/screenshots/desktop-dark-doing-sheet.png",
    "docs/screenshots/desktop-dark-doing-too-long.png",
    "docs/screenshots/desktop-dark-doing.png",
    "docs/screenshots/desktop-dark-history-reviewed.png",
    "docs/screenshots/desktop-dark-history.png",
    "docs/screenshots/desktop-dark-next-up-code-repo.png",
    "docs/screenshots/desktop-dark-next-up.png",
    "docs/screenshots/desktop-dark-settings.png",
    "docs/screenshots/desktop-dark-setup.png",
    "docs/screenshots/desktop-dark-waiting.png",
    "docs/screenshots/phone-dark-doing.png",
    "docs/screenshots/phone-light-next-up-filtered.png"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && node .claude/skills/requirements-yaml/scripts/check.mjs",
    "preview": "sh preview/run.sh",
    "screenshots": "sh preview/screenshots.sh"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.13.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  }
}
